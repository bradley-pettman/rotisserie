# Where the TypeScript JSON API lives. `npm run dev` serves it on 5173.
ROTISSERIE_API_URL=http://localhost:5173

# Must match INTERNAL_API_KEY on the TypeScript side. Leave unset for local
# development, where the API is open; set it in every deployed environment.
# When set, every call this service makes carries it as `X-Api-Key`.
INTERNAL_API_KEY=

# Anthropic credentials are resolved from the environment by the SDK itself --
# the client is constructed with no arguments. Set ANTHROPIC_API_KEY, or log in
# with `ant auth login`.
# ANTHROPIC_API_KEY=

# How long a catalog snapshot is reused before being refetched. The snapshot is
# the cached system-prompt prefix, so this is also the prompt-cache window.
CATALOG_TTL_SECONDS=300

# How many days of cooking history go into the cached prefix.
HISTORY_DAYS=28
