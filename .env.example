DATABASE_URL=postgres://postgres:postgres@localhost:5432/rotisserie_dev?sslmode=disable

# Shared secret for the JSON API under /api/*.
#
# Leave it UNSET for local development and for the Playwright suite: the API is
# then open to anyone who can reach the port, which is fine on localhost.
#
# Set it to a long random string in every deployed environment. When it is set,
# every /api/* request must send a matching `X-Api-Key` header or it is
# rejected with 401. See assertApiAccess() in app/lib/api.ts -- it is the one
# choke point where real per-caller auth should later replace this single
# shared key.
INTERNAL_API_KEY=
